<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.TrainingParametersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:D2G.Iris.ML.ConfigUI.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600">

    <UserControl.Resources>
        <converters:StringToDecimalConverter x:Key="StringToDecimalConverter"/>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InvertedBooleanToVisibilityConverter x:Key="InvertedBooleanToVisibilityConverter"/>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <GroupBox Header="Training Parameters" Margin="10">
            <Grid Margin="15">
                <Grid.RowDefinitions>
                    
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>

                    
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>

                    
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>

                    
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>

                    
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>

                    
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="15"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                
                <Label Grid.Row="0" Grid.Column="0" Content="Model Type:" VerticalAlignment="Center" FontWeight="Bold"/>
                <ComboBox Grid.Row="0" Grid.Column="1" 
                          ItemsSource="{Binding AvailableModelTypes}"
                          SelectedItem="{Binding ModelType}"
                          VerticalAlignment="Center" Height="25"/>

                
                <Label Grid.Row="2" Grid.Column="0" Content="Target Field:" VerticalAlignment="Center" FontWeight="Bold"/>
                <TextBox Grid.Row="2" Grid.Column="1" 
                         Text="{Binding TargetField, UpdateSourceTrigger=PropertyChanged}" 
                         VerticalAlignment="Center" Height="25"/>

                
                <Label Grid.Row="4" Grid.Column="0" Content="Training Mode:" VerticalAlignment="Center" FontWeight="Bold"/>
                <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal">
                    <RadioButton Content="Traditional Training" 
                                 IsChecked="{Binding UseTraditionalTraining}" 
                                 GroupName="TrainingMode"
                                 VerticalAlignment="Center" Margin="0,0,20,0"/>
                    <RadioButton Content="AutoML" 
                                 IsChecked="{Binding UseAutoML}" 
                                 GroupName="TrainingMode"
                                 VerticalAlignment="Center"/>
                </StackPanel>

                
                <TextBlock Grid.Row="6" Grid.Column="0" Grid.ColumnSpan="2" 
                           Text="{Binding TrainingModeDescription}" 
                           TextWrapping="Wrap" 
                           Foreground="DarkBlue"
                           FontStyle="Italic"
                           Margin="0,5"/>

                
                <Label Grid.Row="10" Grid.Column="0" Content="Test Fraction:" VerticalAlignment="Center"
                       Visibility="{Binding UseTraditionalTraining, Converter={StaticResource BooleanToVisibilityConverter}}"/>
                <TextBox Grid.Row="10" Grid.Column="1" 
                         Text="{Binding TestFraction, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource StringToDecimalConverter}}" 
                         VerticalAlignment="Center" Height="25" Width="120" HorizontalAlignment="Left"
                         Visibility="{Binding UseTraditionalTraining, Converter={StaticResource BooleanToVisibilityConverter}}"/>

                
                <GroupBox Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="2" 
                          Header="Traditional Training Settings"
                          Visibility="{Binding UseTraditionalTraining, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Margin="0,5">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        
                        <Label Grid.Row="0" Grid.Column="0" Content="Algorithm:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="0" Grid.Column="1" 
                                  ItemsSource="{Binding AvailableAlgorithms}"
                                  SelectedItem="{Binding SelectedAlgorithm}"
                                  VerticalAlignment="Center" Height="25"
                                  ToolTip="{Binding AlgorithmTooltip}"/>

                        
                        <Label Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Content="Algorithm Parameters:" FontWeight="Bold"/>

                        
                        <ListView Grid.Row="4" Grid.Column="0" Grid.ColumnSpan="2"
                                  ItemsSource="{Binding Parameters}"
                                  SelectedItem="{Binding SelectedParameter}"
                                  SelectionMode="Single"
                                  MinHeight="150"
                                  BorderBrush="#CCCCCC"
                                  BorderThickness="1"
                                  Background="White"
                                  AlternationCount="2">
                            <ListView.Resources>
                                
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                                    <Setter Property="Padding" Value="4,2"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0,0,0,1"/>
                                    <Style.Triggers>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="0">
                                            <Setter Property="Background" Value="#F8F8F8"/>
                                        </Trigger>
                                        <Trigger Property="ItemsControl.AlternationIndex" Value="1">
                                            <Setter Property="Background" Value="White"/>
                                        </Trigger>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter Property="Background" Value="#E3F2FD"/>
                                            <Setter Property="Foreground" Value="#1976D2"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter Property="Background" Value="#F0F7FF"/>
                                        </Trigger>
                                    </Style.Triggers>
                                </Style>
                                
                                
                                <Style TargetType="GridViewColumnHeader">
                                    <Setter Property="Background" Value="#F0F0F0"/>
                                    <Setter Property="BorderBrush" Value="#CCCCCC"/>
                                    <Setter Property="BorderThickness" Value="0,0,1,1"/>
                                    <Setter Property="Padding" Value="6,4"/>
                                    <Setter Property="FontWeight" Value="SemiBold"/>
                                    <Setter Property="Foreground" Value="#333333"/>
                                    <Setter Property="HorizontalContentAlignment" Value="Left"/>
                                </Style>
                            </ListView.Resources>
                            
                            <ListView.View>
                                <GridView AllowsColumnReorder="False">
                                    <GridViewColumn Header="Parameter Name" Width="250">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Name}" 
                                                          FontWeight="Medium"
                                                          FontSize="12"
                                                          VerticalAlignment="Center"
                                                          Margin="4,0"/>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    
                                    <GridViewColumn Header="Value" Width="200">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border Background="#F8F8F8" 
                                                       CornerRadius="2" 
                                                       Padding="2"
                                                       BorderBrush="#E0E0E0"
                                                       BorderThickness="1">
                                                    <TextBox Text="{Binding ValueString, UpdateSourceTrigger=PropertyChanged}" 
                                                            FontFamily="Consolas"
                                                            FontSize="13"
                                                            Foreground="#2E7D32"
                                                            Background="Transparent"
                                                            BorderThickness="0"
                                                            VerticalAlignment="Center"
                                                            Padding="2,0"/>
                                                </Border>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>

                        
                        <StackPanel Grid.Row="5" Grid.Column="0" Grid.ColumnSpan="2" 
                                    Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">

                            <Button Content="Add Parameter" 
                                    Command="{Binding AddParameterCommand}"
                                    Width="120" Height="32" Margin="0,0,10,0"
                                    Background="#4CAF50"
                                    Foreground="White"
                                    BorderBrush="#4CAF50"
                                    BorderThickness="1"
                                    FontWeight="Medium"
                                    Style="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"
                                                            Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#66BB6A"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#388E3C"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#CCCCCC"/>
                                                <Setter Property="Foreground" Value="#666666"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>

                            <Button Content="Remove" 
                                    Command="{Binding RemoveParameterCommand}"
                                    Width="80" Height="32"
                                    Background="#F44336"
                                    Foreground="White"
                                    BorderBrush="#F44336"
                                    BorderThickness="1"
                                    FontWeight="Medium"
                                    Style="{x:Null}">
                                <Button.Template>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}"
                                               BorderBrush="{TemplateBinding BorderBrush}"
                                               BorderThickness="{TemplateBinding BorderThickness}"
                                               CornerRadius="3">
                                            <ContentPresenter HorizontalAlignment="Center" 
                                                            VerticalAlignment="Center"
                                                            Margin="{TemplateBinding Padding}"/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="#EF5350"/>
                                            </Trigger>
                                            <Trigger Property="IsPressed" Value="True">
                                                <Setter Property="Background" Value="#D32F2F"/>
                                            </Trigger>
                                            <Trigger Property="IsEnabled" Value="False">
                                                <Setter Property="Background" Value="#CCCCCC"/>
                                                <Setter Property="Foreground" Value="#666666"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Button.Template>
                            </Button>
                        </StackPanel>
                    </Grid>
                </GroupBox>

                
                <GroupBox Grid.Row="8" Grid.Column="0" Grid.ColumnSpan="2" 
                          Header="AutoML Settings"
                          Visibility="{Binding UseAutoML, Converter={StaticResource BooleanToVisibilityConverter}}"
                          Margin="0,5">
                    <Grid Margin="10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="15"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>


                        <Label Grid.Row="0" Grid.Column="0" Content="Max Experiment Time:" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding MaxExperimentTimeInSeconds, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Height="25" Width="80"/>
                            <Label Content="seconds" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>


                        <Label Grid.Row="2" Grid.Column="0" Content="Max Models to Try:" VerticalAlignment="Center"/>
                        <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal">
                            <TextBox Text="{Binding MaxModels, UpdateSourceTrigger=PropertyChanged}"
                                     VerticalAlignment="Center" Height="25" Width="80"/>
                            <Label Content="models" VerticalAlignment="Center" Margin="5,0,0,0"/>
                        </StackPanel>


                        <Label Grid.Row="4" Grid.Column="0" Content="Optimizing Metric:" VerticalAlignment="Center"/>
                        <ComboBox Grid.Row="4" Grid.Column="1"
                                  ItemsSource="{Binding AvailableMetrics}"
                                  SelectedItem="{Binding OptimizingMetric}"
                                  VerticalAlignment="Center" Height="25" Width="200" HorizontalAlignment="Left"/>
                    </Grid>
                </GroupBox>
            </Grid>
        </GroupBox>
    </ScrollViewer>
</UserControl>