<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.InputFieldsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:D2G.Iris.ML.ConfigUI.WPF.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="600">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter"/>
        <converters:InverseBooleanConverter x:Key="InverseBooleanConverter"/>
    </UserControl.Resources>

    <GroupBox Header="Input Fields" Margin="10">
        <Grid Margin="15">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            
            <DataGrid Grid.Row="0" 
                      ItemsSource="{Binding InputFields}"
                      SelectedItem="{Binding SelectedField}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionMode="Single"
                      GridLinesVisibility="All"
                      AlternatingRowBackground="LightGray">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="Field Name" 
                                        Binding="{Binding Name}" 
                                        Width="*" 
                                        IsReadOnly="True"/>

                    <DataGridCheckBoxColumn Header="Enabled" 
                                            Binding="{Binding IsEnabled}" 
                                            Width="80"/>
                </DataGrid.Columns>
            </DataGrid>

            
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">

                <!-- Selection Buttons -->
                <Button Content="Select All" 
                        Command="{Binding SelectAllCommand}"
                        Background="LightGreen"
                        Width="80" Height="30" Margin="0,0,5,0"/>

                <Button Content="Deselect All" 
                        Command="{Binding DeselectAllCommand}"
                        Background="LightCoral"
                        Width="90" Height="30" Margin="0,0,15,0"/>
                
                <Button Content="Load from Database"
                        Command="{Binding LoadFromDatabaseCommand}"
                        Background="LightBlue"
                        Width="140" Height="30" Margin="0,0,10,0"
                        IsEnabled="{Binding IsLoadingFromDatabase, Converter={StaticResource InverseBooleanConverter}}">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Content" Value="Load from Database"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLoadingFromDatabase}" Value="True">
                                    <Setter Property="Content" Value="Loading..."/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                
                <Button Content="Add" 
                        Command="{Binding AddFieldCommand}"
                        Width="60" Height="30" Margin="0,0,5,0"/>

                
                <Button Content="Edit" 
                        Command="{Binding EditFieldCommand}"
                        Width="60" Height="30" Margin="0,0,5,0"/>

                
                <Button Content="Remove" 
                        Command="{Binding RemoveFieldCommand}"
                        Width="70" Height="30"/>
            </StackPanel>
        </Grid>
    </GroupBox>
</UserControl>