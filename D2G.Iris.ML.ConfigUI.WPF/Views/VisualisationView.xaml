<UserControl x:Class="D2G.Iris.ML.ConfigUI.WPF.Views.VisualisationView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:s="http://schemas.abtsoftware.co.uk/scichart"
             xmlns:converters="clr-namespace:D2G.Iris.ML.ConfigUI.WPF.Converters"
             mc:Ignorable="d"
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>
        <converters:InverseBooleanToVisibilityConverter x:Key="InverseBooleanToVisibilityConverter" />
        <converters:CountToVisibilityConverter x:Key="CountToVisibilityConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        
        <Style x:Key="SelectableHistogramBorder" TargetType="Border">
            <Setter Property="BorderBrush" Value="LightGray"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#FF4682B4"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <Setter Property="Background" Value="#FFF0F8FF"/>
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#FF87CEEB"/>
                    <Setter Property="Background" Value="#FFFAFAFA"/>
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="HistogramTemplate">
            <Border Style="{StaticResource SelectableHistogramBorder}" Margin="5" MinWidth="300"
                    MouseLeftButtonDown="HistogramBorder_MouseLeftButtonDown">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Header with column info -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,5">
                        <TextBlock Text="{Binding ColumnName}" FontWeight="Bold" FontSize="14"/>
                        <TextBlock Text=" (" Margin="5,0,0,0"/>
                        <TextBlock Text="{Binding ColumnType}" FontStyle="Italic"/>
                        <TextBlock Text=")"/>
                        <TextBlock Text=" - " Margin="5,0,0,0"/>
                        <TextBlock Text="{Binding TotalCount}"/>
                        <TextBlock Text=" records" Margin="2,0,0,0"/>
                        
                    </StackPanel>
                    
                    <!-- Chart area -->
                    <Grid Grid.Row="1">
                        <s:SciChartSurface Height="200" Margin="10">
                            <s:SciChartSurface.XAxis>
                                <s:NumericAxis DrawMajorBands="True" 
                                             GrowBy="0.05, 0.05"
                                             AutoRange="Always"/>
                            </s:SciChartSurface.XAxis>
                            <s:SciChartSurface.YAxis>
                                <s:NumericAxis DrawMajorBands="True"
                                             GrowBy="0.05, 0.1"
                                             AutoRange="Always"/>
                            </s:SciChartSurface.YAxis>
                            <s:SciChartSurface.RenderableSeries>
                                <s:FastColumnRenderableSeries DataSeries="{Binding DataSeries}"
                                                            Fill="#FF4682B4"
                                                            Stroke="#FF4682B4"
                                                            StrokeThickness="1"/>
                            </s:SciChartSurface.RenderableSeries>
                            <s:SciChartSurface.ChartModifier>
                                <s:ModifierGroup>
                                    <s:ZoomPanModifier/>
                                    <s:MouseWheelZoomModifier/>
                                    <s:ZoomExtentsModifier/>
                                    <s:CursorModifier/>
                                </s:ModifierGroup>
                            </s:SciChartSurface.ChartModifier>
                        </s:SciChartSurface>
                        
                        <!-- Loading overlay for individual histograms -->
                        <Border Background="#80FFFFFF" 
                               Visibility="{Binding IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <ProgressBar IsIndeterminate="True" Width="100" Height="4" Margin="0,0,0,10"/>
                                <TextBlock Text="Loading..." FontSize="12" HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    
                    <!-- Action text -->
                    <TextBlock Grid.Row="2" Text="Click to view detailed analysis" 
                               HorizontalAlignment="Center" Margin="5"
                               FontSize="11" FontStyle="Italic" Foreground="Gray"/>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <!-- Progress Overlay -->
        <Border Background="#80000000" Visibility="{Binding IsGeneratingHistograms, Converter={StaticResource BooleanToVisibilityConverter}}" 
                Panel.ZIndex="1000">
            <Border Background="White" CornerRadius="8" Padding="30" 
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    BorderBrush="LightGray" BorderThickness="1">
                <StackPanel>
                    <TextBlock Text="Generating Histograms..." FontSize="16" FontWeight="SemiBold" 
                               HorizontalAlignment="Center" Margin="0,0,0,15"/>
                    <ProgressBar IsIndeterminate="True" Height="6" Width="300" Margin="0,0,0,15"/>
                    <TextBlock Text="{Binding ProgressMessage}" FontSize="14" 
                               HorizontalAlignment="Center" Margin="0,0,0,15" Foreground="Gray"/>
                    <Button Content="Cancel" Command="{Binding CancelGenerationCommand}" 
                            Background="#FFE74C3C" Foreground="White" BorderThickness="0"
                            Padding="20,8" Cursor="Hand" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Border>

        <!-- Overview Grid -->
        <Grid Visibility="{Binding IsDetailViewVisible, Converter={StaticResource InverseBooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Generate Histograms Button -->
            <Border Grid.Row="0" Background="#FFF8F8F8" BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="15">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Generate Histograms" 
                            Command="{Binding GenerateHistogramsCommand}"
                            Background="#FF4682B4" Foreground="White" BorderThickness="0"
                            Padding="20,10" Cursor="Hand" FontSize="14" FontWeight="Medium"
                            ToolTip="Generate histogram visualizations for all numeric columns"/>
                    <TextBlock Text="{Binding DataInfo}" 
                               VerticalAlignment="Center" Margin="15,0,0,0" 
                               FontStyle="Italic" Foreground="Gray"/>
                </StackPanel>
            </Border>
            
            <!-- Histograms Display -->
            <Grid Grid.Row="1">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl ItemsSource="{Binding Histograms}" 
                                 ItemTemplate="{StaticResource HistogramTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </ScrollViewer>
                
                <TextBlock Text="Click 'Generate Histograms' to create visualizations for all numeric columns."
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           FontSize="16"
                           Foreground="Gray"
                           Visibility="{Binding Histograms.Count, Converter={StaticResource CountToVisibilityConverter}, ConverterParameter=Inverse}"/>
            </Grid>
        </Grid>

        <!-- Detail View -->
        <Grid Visibility="{Binding IsDetailViewVisible, Converter={StaticResource BooleanToVisibilityConverter}}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            
            <!-- Header with Back Button -->
            <Border Grid.Row="0" Background="#FFF8F8F8" BorderBrush="LightGray" BorderThickness="0,0,0,1" Padding="15">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <Button Grid.Column="0" Content="← Back to Overview" 
                            Command="{Binding BackToOverviewCommand}"
                            Background="Transparent" BorderThickness="1" BorderBrush="#FF4682B4"
                            Foreground="#FF4682B4" Padding="10,5" Margin="0,0,15,0"
                            Cursor="Hand"/>
                    
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <TextBlock Text="Detailed Analysis: " FontSize="18" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedHistogram.ColumnName}" FontSize="18" FontWeight="Bold" Foreground="#FF4682B4"/>
                        <TextBlock Text=" (" FontSize="16" Margin="5,0,0,0"/>
                        <TextBlock Text="{Binding SelectedHistogram.ColumnType}" FontSize="16" FontStyle="Italic"/>
                        <TextBlock Text=")" FontSize="16"/>
                    </StackPanel>
                </Grid>
            </Border>
            
            <!-- Detail Content -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <Grid Margin="20">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Large Chart -->
                    <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="1" Background="White" CornerRadius="8" Margin="0,0,0,20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <TextBlock Grid.Row="0" Text="Distribution Chart" FontSize="16" FontWeight="SemiBold" 
                                      Margin="15,15,15,10"/>
                            
                            <s:SciChartSurface Grid.Row="1" Height="400" Margin="15,0,15,15">
                                <s:SciChartSurface.XAxis>
                                    <s:NumericAxis DrawMajorBands="True" 
                                                 GrowBy="0.02, 0.02"
                                                 AutoRange="Always"/>
                                </s:SciChartSurface.XAxis>
                                <s:SciChartSurface.YAxis>
                                    <s:NumericAxis DrawMajorBands="True" 
                                                 GrowBy="0.05, 0.1"
                                                 AutoRange="Always"/>
                                </s:SciChartSurface.YAxis>
                                <s:SciChartSurface.RenderableSeries>
                                    <s:FastColumnRenderableSeries DataSeries="{Binding SelectedHistogram.DataSeries}"
                                                                Fill="#FF4682B4"
                                                                Stroke="#FF4682B4"
                                                                StrokeThickness="1"/>
                                </s:SciChartSurface.RenderableSeries>
                                <s:SciChartSurface.ChartModifier>
                                    <s:ModifierGroup>
                                        <s:ZoomPanModifier/>
                                        <s:MouseWheelZoomModifier/>
                                        <s:ZoomExtentsModifier/>
                                        <s:CursorModifier/>
                                    </s:ModifierGroup>
                                </s:SciChartSurface.ChartModifier>
                            </s:SciChartSurface>
                        </Grid>
                    </Border>
                    
                    <!-- Statistics Panel -->
                    <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Background="White" CornerRadius="8">
                        <StackPanel Margin="20">
                            <TextBlock Text="Statistical Summary" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,15"/>
                            
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                
                                <!-- Basic Statistics -->
                                <StackPanel Grid.Column="0" Margin="0,0,20,0">
                                    <TextBlock Text="Basic Statistics" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedHistogram.Statistics.Mean, StringFormat='Mean: {0:F2}'}" Margin="0,2"/>
                                        <TextBlock Text="{Binding SelectedHistogram.Statistics.Median, StringFormat='Median: {0:F2}'}" Margin="0,2"/>
                                        <TextBlock Text="{Binding SelectedHistogram.Statistics.StandardDeviation, StringFormat='Std Dev: {0:F2}'}" Margin="0,2"/>
                                        <TextBlock Text="{Binding SelectedHistogram.Statistics.Variance, StringFormat='Variance: {0:F2}'}" Margin="0,2"/>
                                        <TextBlock Text="{Binding SelectedHistogram.Statistics.Range, StringFormat='Range: {0:F2}'}" Margin="0,2"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Range Statistics -->
                                <StackPanel Grid.Column="1" Margin="0,0,20,0">
                                    <TextBlock Text="Range &amp; Quartiles" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedHistogram.Statistics.Min, StringFormat='Minimum: {0:F2}'}" Margin="0,2"/>
                                        <TextBlock Text="{Binding SelectedHistogram.Statistics.Q1, StringFormat='Q1 (25%): {0:F2}'}" Margin="0,2"/>
                                        <TextBlock Text="{Binding SelectedHistogram.Statistics.Q3, StringFormat='Q3 (75%): {0:F2}'}" Margin="0,2"/>
                                        <TextBlock Text="{Binding SelectedHistogram.Statistics.Max, StringFormat='Maximum: {0:F2}'}" Margin="0,2"/>
                                        <TextBlock Text="{Binding SelectedHistogram.Statistics.IQR, StringFormat='IQR: {0:F2}'}" Margin="0,2"/>
                                    </StackPanel>
                                </StackPanel>
                                
                                <!-- Distribution Statistics -->
                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Distribution &amp; Quality" FontWeight="SemiBold" Margin="0,0,0,10"/>
                                    <StackPanel>
                                        <TextBlock Text="{Binding SelectedHistogram.Statistics.Skewness, StringFormat='Skewness: {0:F3}'}" Margin="0,2"/>
                                        <TextBlock Text="{Binding SelectedHistogram.Statistics.Kurtosis, StringFormat='Kurtosis: {0:F3}'}" Margin="0,2"/>
                                        <TextBlock Text="{Binding SelectedHistogram.Statistics.UniqueValues, StringFormat='Unique Values: {0}'}" Margin="0,2"/>
                                        <TextBlock Text="{Binding SelectedHistogram.Statistics.MissingValues, StringFormat='Missing Values: {0}'}" Margin="0,2"/>
                                        <TextBlock Text="{Binding SelectedHistogram.TotalCount, StringFormat='Total Records: {0}'}" Margin="0,2"/>
                                    </StackPanel>
                                </StackPanel>
                            </Grid>
                            
                            <!-- Most Frequent Value -->
                            <Border Background="#FFF8F8F8" BorderBrush="LightGray" BorderThickness="1" 
                                   CornerRadius="4" Padding="15" Margin="0,15,0,0">
                                <StackPanel>
                                    <TextBlock Text="Most Frequent Value" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Value: " FontWeight="Medium"/>
                                        <TextBlock Text="{Binding SelectedHistogram.Statistics.MostFrequentValue}" FontFamily="Consolas"/>
                                        <TextBlock Text=" (appears " Margin="10,0,0,0"/>
                                        <TextBlock Text="{Binding SelectedHistogram.Statistics.MostFrequentCount}"/>
                                        <TextBlock Text=" times)"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
